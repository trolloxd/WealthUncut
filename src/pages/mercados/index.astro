---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { isPublished } from '../../lib/posts';
import FranjaMercados from '../../components/FranjaMercados.astro';

const dias = (await getCollection('mercados', ({ data }) => isPublished(data))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [ultima, ...anteriores] = dias;
const fecha =(d: Date) => d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Noticias de mercados: qué ha pasado y por qué te afecta"
  description="Cada mañana, lo más importante de los mercados explicado sin jerga: qué ha pasado, por qué y a qué afecta a tus ahorros, con datos oficiales y gráficas."
>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Noticias' }]} />
  <h1 class="mb-4 font-display text-3xl text-ink">Noticias de mercados y economía</h1>
  <p class="mb-10 max-w-2xl text-ink-muted">
    Cada mañana, lo más importante del día anterior en los mercados, explicado sin jerga: qué ha
    pasado, por qué y a qué afecta a tus ahorros, tu hipoteca o tus inversiones. Con datos oficiales
    del Banco Central Europeo y cada cifra contrastada en varias fuentes. Es información, no una
    recomendación de inversión.
  </p>
  <FranjaMercados />
  {!ultima ? (
    <p class="text-ink-muted">Todavía no hay ninguna edición publicada.</p>
  ) : (
    <>
    <a href={`/mercados/${ultima.id}/`} class="card group mb-12 block p-6 hover:border-brand/40 sm:p-8">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold uppercase tracking-wide">
        <span class="rounded-full bg-brand-soft px-2.5 py-1 text-brand">Última edición</span>
        <time datetime={ultima.id} class="text-ink-muted">{fecha(ultima.data.pubDate)}</time>
      </p>
      <h2 class="mt-3 font-display text-2xl leading-snug text-ink group-hover:text-brand sm:text-3xl">{ultima.data.title}</h2>
      <p class="mt-3 text-ink-muted">{ultima.data.description}</p>
      <span class="mt-5 inline-block text-sm font-semibold text-brand">Leer la edición <span aria-hidden="true">→</span></span>
    </a>
    {anteriores.length > 0 && <h2 class="mb-6 font-display text-xl text-ink">Ediciones anteriores</h2>}
    <ul class="grid gap-8">
      {anteriores.map((dia) => (
        <li class="aparece border-b border-border pb-8 last:border-none">
          <a href={`/mercados/${dia.id}/`} class="group block">
            <p class="text-xs font-semibold uppercase tracking-wide text-brand">
              <time datetime={dia.id}>{fecha(dia.data.pubDate)}</time>
            </p>
            <h3 class="mt-1 font-display text-xl text-ink group-hover:text-brand">{dia.data.title}</h3>
            <p class="mt-2 text-ink-muted">{dia.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
    </>
  )}
</BaseLayout>
