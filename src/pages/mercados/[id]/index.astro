---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleMeta from '../../../components/ArticleMeta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleLink from '../../../components/ArticleLink.astro';
import { isPublished } from '../../../lib/posts';
import { SITE } from '../../../config/site';

export async function getStaticPaths() {
  const dias = (await getCollection('mercados', ({ data }) => isPublished(data))).sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
  );
  return dias.map((dia, i) => ({
    params: { id: dia.id },
    props: { dia, anterior: dias[i - 1], siguiente: dias[i + 1] },
  }));
}

const { dia, anterior, siguiente } = Astro.props;
const { Content } = await render(dia);
const { title, description, pubDate, updatedDate, author, sources, tags } = dia.data;
const url = `${SITE.url}/mercados/${dia.id}/`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  '@id': `${url}#article`,
  headline: title,
  description,
  image: `${SITE.url}/og-default.png`,
  inLanguage: SITE.locale,
  keywords: tags.join(', '),
  author: { '@id': `${SITE.url}/autor/#person`, '@type': 'Person', name: author, url: `${SITE.url}/autor/` },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  publisher: { '@id': `${SITE.url}/#organization` },
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntityOfPage: url,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Mercados', item: `${SITE.url}/mercados/` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedDate={pubDate}
  updatedDate={updatedDate}
  extraJsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Mercados', href: '/mercados/' }, { label: title }]} />
  <article class="prose max-w-none">
    <h1>{title}</h1>
    <ArticleMeta author={author} pubDate={pubDate} updatedDate={updatedDate} sources={sources} hasAffiliateLinks={false}>
      <Content components={{ a: ArticleLink }} />
    </ArticleMeta>
  </article>

  <nav aria-label="Otros días" class="mt-12 flex flex-wrap justify-between gap-4 border-t border-border pt-6 text-sm">
    {anterior ? (
      <a href={`/mercados/${anterior.id}/`} class="text-brand underline decoration-brand/30 hover:decoration-brand">← {anterior.data.title}</a>
    ) : <span />}
    {siguiente && (
      <a href={`/mercados/${siguiente.id}/`} class="text-right text-brand underline decoration-brand/30 hover:decoration-brand">{siguiente.data.title} →</a>
    )}
  </nav>
</BaseLayout>
