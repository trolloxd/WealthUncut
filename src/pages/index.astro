---
import { getCollection } from 'astro:content';
import { isPublished } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, AUTHOR } from '../config/site';
import { TOOLS } from '../config/tools';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import DatosDeHoy from '../components/DatosDeHoy.astro';
import ArticulosEditorial from '../components/ArticulosEditorial.astro';
import IconoTema from '../components/IconoTema.astro';
import HeroPortada from '../components/HeroPortada.astro';
import PilaIrpf from '../components/PilaIrpf.astro';
import { CATEGORIAS, categoriaDe } from '../config/categorias';

const ultimaEdicion = (await getCollection('mercados', ({ data }) => isPublished(data))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)[0];

const publicados = (await getCollection('blog', ({ data }) => isPublished(data))).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const temas = CATEGORIAS.map((c) => ({ c, n: publicados.filter((x) => categoriaDe(x.data).id === c.id).length })).filter((x) => x.n > 0);

// Las 6 calculadoras que se ven de entrada en la portada; el resto se despliega con "Ver todas".
const TOP_CALCULADORAS = [
  '/blog/rentabilidad-neta-fondo-indexado/',
  '/herramientas/calculadora-interes-compuesto/',
  '/herramientas/calculadora-sueldo-neto/',
  '/herramientas/simulador-hipoteca-euribor/',
  '/herramientas/alquilar-o-comprar-vivienda/',
  '/herramientas/calculadora-fondo-de-emergencia/',
];
// Etiqueta corta de cada calculadora destacada (el dato que cambias en ella).
const ETIQUETA_CALC: Record<string, string> = {
  '/herramientas/calculadora-interes-compuesto/': 'Euros de hoy',
  '/herramientas/calculadora-sueldo-neto/': 'IRPF de tu comunidad',
  '/herramientas/simulador-hipoteca-euribor/': 'Fija, variable o mixta',
  '/herramientas/alquilar-o-comprar-vivienda/': 'Hipoteca o alquiler',
  '/herramientas/calculadora-fondo-de-emergencia/': 'Según tus gastos',
};
const destacadas = TOP_CALCULADORAS.map((href) => TOOLS.find((t) => t.href === href)).filter((t) => t !== undefined);
const resto = TOOLS.filter((t) => !TOP_CALCULADORAS.includes(t.href));
---

<BaseLayout title="Calculadoras y guías de finanzas personales en España" description={SITE.description} contentWidth="wide">
  <HeroPortada />

  <DatosDeHoy />

  {ultimaEdicion && (
    <section class="mx-auto mt-4 max-w-3xl border-t border-border pt-10">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="font-display text-2xl text-ink">Noticias del día</h2>
        <a href="/hoy/" class="text-sm font-medium text-brand underline decoration-brand/30 hover:decoration-brand">Tu briefing de hoy</a>
      </div>
      <a href={`/mercados/${ultimaEdicion.id}/`} class="card group block p-6 hover:border-brand/40">
        <span class="text-xs font-semibold uppercase tracking-wide text-brand">Noticias de hoy</span>
        <span class="mt-2 block font-display text-xl text-ink group-hover:text-brand">{ultimaEdicion.data.title}</span>
        <span class="mt-2 block text-sm text-ink-muted">{ultimaEdicion.data.description}</span>
      </a>
    </section>
  )}

  <!--
    Últimos artículos: el más reciente como pieza principal (bloque verde con la ilustración de su tema) y los cuatro
    siguientes en una lista con tema, fecha y minutos de lectura (ArticulosEditorial, con entrada escalonada).
  -->
  <section aria-labelledby="h-ultimos" class="mt-12 border-t border-border pt-12">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2 id="h-ultimos" class="font-display text-2xl text-ink">Últimos artículos</h2>
      {publicados.length > 0 && (
        <a href="/blog/" class="enlace-todos">
          Ver el blog ({publicados.length} {publicados.length === 1 ? 'artículo' : 'artículos'}) <span class="enlace-todos-flecha" aria-hidden="true">→</span>
        </a>
      )}
    </div>
    {publicados.length === 0 ? (
      <p class="rounded-2xl bg-cream-elevated p-6 text-ink-muted">Todavía no hay artículos publicados.</p>
    ) : (
      <ArticulosEditorial posts={publicados.slice(0, 5)} modo="lado" />
    )}
  </section>

  <PilaIrpf />

  {temas.length > 0 && (
    <section aria-labelledby="h-temas" class="mt-16">
      <h2 id="h-temas" class="mb-2 font-display text-3xl tracking-tight text-ink sm:text-4xl">Temas</h2>
      <p class="mb-6 max-w-2xl text-sm text-ink-muted">Guías agrupadas por lo que quieres resolver: invertir, impuestos, vivienda, autónomos y más.</p>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {temas.map(({ c, n }) => (
          <li class="aparece">
            <a href={`/blog/tema/${c.id}/`} class="tema-b group flex h-full items-center gap-4 rounded-[1.4rem] border border-border bg-cream-elevated p-4">
              <IconoTema tema={c.id} class="h-16 w-16 shrink-0" />
              <span class="block min-w-0">
                <span class="block text-base font-bold text-ink">{c.nombre}</span>
                <span class="mt-1 block text-sm text-ink-muted">{c.descripcion}</span>
                <span class="mt-2 block text-xs text-ink-faint">{n} {n === 1 ? 'artículo' : 'artículos'}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="h-calcs" class="mt-16">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="h-calcs" class="font-display text-3xl tracking-tight text-ink sm:text-4xl">Elige qué quieres calcular</h2>
      <a href="/herramientas/" id="ver-todas-calc" aria-controls="calc-resto" aria-expanded="false" data-total={TOOLS.length} class="text-sm font-semibold text-brand underline decoration-brand/30 hover:decoration-brand">Ver todas ({TOOLS.length})</a>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {destacadas.map((t, i) => i === 0 ? (
        <li class="sm:col-span-2 lg:row-span-2">
          <a href={t.href} class="caja-b grid h-full min-h-[16rem] content-center items-center gap-6 bg-brand p-7 text-cream-elevated sm:grid-cols-2 sm:p-8">
            <span class="block">
              <span class="block text-sm text-brand-soft">La más usada</span>
              <span class="mt-2 block font-display text-3xl leading-tight">{t.name}</span>
              <span class="mt-3 block text-brand-soft">{t.description}</span>
            </span>
            <span class="relative block h-40" aria-hidden="true">
              <span class="capa-b capa-b-1 absolute inset-[1.25rem_2rem_0_0] block rounded-2xl bg-[#2c6650]"></span>
              <span class="capa-b capa-b-2 absolute inset-[0_0_2rem_2.5rem] block rounded-2xl bg-cream-elevated p-4 text-ink shadow-[0_20px_40px_-20px_rgba(0,0,0,0.5)]">
                <span class="block text-xs text-ink-muted">Neto a 20 años con 150 €/mes</span>
                <span class="mt-1 block font-display text-3xl text-brand">69.630 €</span>
              </span>
            </span>
          </a>
        </li>
      ) : (
        <li>
          <a href={t.href} class="caja-b flex h-full min-h-[12rem] flex-col justify-between gap-6 border border-border bg-cream-elevated p-6 text-ink">
            <span class:list={['capa-b capa-b-1 self-start rounded-xl px-3.5 py-2 text-sm font-bold', i % 2 ? 'bg-accent-soft text-[#8a3120]' : 'bg-brand-soft text-brand']}>{ETIQUETA_CALC[t.href] ?? 'Calculadora'}</span>
            <span class="block">
              <span class="block font-display text-2xl leading-snug">{t.name}</span>
              <span class="mt-2 block text-sm text-ink-muted">{t.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <ul id="calc-resto" class="mt-4 grid gap-4 sm:grid-cols-2" hidden>
      {resto.map((t) => (
        <li>
          <a href={t.href} class="card group block h-full p-5 hover:border-brand/40">
            <span class="font-display text-lg text-ink group-hover:text-brand">{t.name} <span class="card-flecha" aria-hidden="true">→</span></span>
            <span class="mt-2 block text-sm text-ink-muted">{t.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script>
    // "Ver todas" despliega aquí mismo el resto de calculadoras. Sin JavaScript sigue siendo un enlace a /herramientas/.
    const boton = document.getElementById('ver-todas-calc');
    const resto = document.getElementById('calc-resto');
    if (boton && resto) {
      boton.setAttribute('role', 'button');
      boton.addEventListener('click', (e) => {
        e.preventDefault();
        const abrir = resto.hidden;
        resto.hidden = !abrir;
        boton.setAttribute('aria-expanded', String(abrir));
        boton.textContent = abrir ? 'Ver menos' : `Ver todas (${boton.dataset.total})`;
        if (!abrir) boton.closest('section')?.scrollIntoView({ block: 'start' });
      });
    }
  </script>

  <section class="aparece mx-auto mt-12 max-w-md border-t border-border pt-12">
    <NewsletterSignup />
  </section>
</BaseLayout>
