---
import { getCollection } from 'astro:content';
import { isPublished } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const posts = (await getCollection('blog', ({ data }) => isPublished(data)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title="Página no encontrada" description={`Esta página no existe en ${SITE.name}.`} noindex>
  <div class="flex flex-col items-start gap-4 py-16">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand">Error 404</p>
    <h1 class="font-display text-4xl text-ink">Esta página no existe.</h1>
    <p class="max-w-md text-ink-muted">
      Puede que el enlace esté mal escrito o que el contenido se haya movido.
    </p>
    <div class="mt-4 flex gap-3">
      <a href="/" class="btn-primary">Volver al inicio</a>
      <a href="/blog/" class="btn-secondary">Ver el blog</a>
    </div>
    {posts.length > 0 && (
      <div class="mt-10 w-full border-t border-border pt-8">
        <h2 class="mb-4 font-display text-xl text-ink">Quizá buscabas</h2>
        <ul class="grid gap-3">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="text-brand underline decoration-brand/30 hover:decoration-brand">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</BaseLayout>
