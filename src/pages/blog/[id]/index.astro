---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleMeta from '../../../components/ArticleMeta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleLink from '../../../components/ArticleLink.astro';
import { SITE } from '../../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, sources, hasAffiliateLinks, tags } = post.data;
const url = `${SITE.url}/blog/${post.id}/`;

// Artículos relacionados: los que comparten más etiquetas, y a igualdad, los más recientes.
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({ post: p, shared: p.data.tags.filter((t) => tags.includes(t)).length }))
  .sort((a, b) => b.shared - a.shared || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map((r) => r.post);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: title,
  description,
  image: `${SITE.url}/og-default.png`,
  inLanguage: SITE.locale,
  keywords: tags.join(', '),
  author: { '@id': `${SITE.url}/autor/#person`, '@type': 'Person', name: author, url: `${SITE.url}/autor/` },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  publisher: { '@id': `${SITE.url}/#organization` },
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntityOfPage: url,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedDate={pubDate}
  updatedDate={updatedDate}
  extraJsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: title }]} />
  <article class="prose max-w-none">
    <h1>{title}</h1>
    <ArticleMeta author={author} pubDate={pubDate} updatedDate={updatedDate} sources={sources} hasAffiliateLinks={hasAffiliateLinks}>
      <Content components={{ a: ArticleLink }} />
    </ArticleMeta>
  </article>

  {related.length > 0 && (
    <aside aria-labelledby="sigue-leyendo" class="mt-12 border-t border-border pt-8">
      <h2 id="sigue-leyendo" class="mb-5 font-display text-xl text-ink">Sigue leyendo</h2>
      <ul class="grid gap-5">
        {related.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`} class="group block">
              <span class="font-display text-lg text-ink group-hover:text-brand">{p.data.title}</span>
              <span class="mt-1 block text-sm text-ink-muted">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )}
</BaseLayout>
