---
import { getCollection, render } from 'astro:content';
import { isPublished } from '../../../lib/posts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { minutosDeLectura } from '../../../lib/briefing';
import ArticleMeta from '../../../components/ArticleMeta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleLink from '../../../components/ArticleLink.astro';
import { SITE } from '../../../config/site';
import { herramientasRelacionadas } from '../../../config/tools';
import { categoriaDe } from '../../../config/categorias';
import { terminosEnTexto } from '../../../lib/glosario-enlaces';
import SeccionH2 from '../../../components/SeccionH2.astro';
import { idH2Medio } from '../../../lib/cta-medio';
import NewsletterSignup from '../../../components/NewsletterSignup.astro';
import IndiceArticulo from '../../../components/IndiceArticulo.astro';
import ListadoTarjetas from '../../../components/ListadoTarjetas.astro';
import { TEMAS_MEDIBLES, VARIANTES_FINAL, ctaDeTema, variantePara } from '../../../config/cta.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => isPublished(data));
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, author, sources, hasAffiliateLinks, tags, resumen } = post.data;
const url = `${SITE.url}/blog/${post.id}/`;
const categoria = categoriaDe(post.data);
const temaCta = TEMAS_MEDIBLES.includes(categoria.id) ? categoria.id : 'otro';
const idH2 = idH2Medio(headings);
(Astro.locals as unknown as Record<string, unknown>).ctaMedio = idH2 ? { idH2, slug: post.id, tema: temaCta } : undefined;
const varianteFinal = variantePara(post.id, new Date(), VARIANTES_FINAL);

// Artículos relacionados: los que comparten más etiquetas, y a igualdad, los más recientes.
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({ post: p, shared: p.data.tags.filter((t) => tags.includes(t)).length + (categoriaDe(p.data).id === categoria.id ? 2 : 0) }))
  .sort((a, b) => b.shared - a.shared || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map((r) => r.post);

const herramientas = herramientasRelacionadas(tags, `/blog/${post.id}/`, 3);

// Más guías del mismo tema (las que no salen ya en "Sigue leyendo") y términos del glosario que aparecen en el texto.
const yaMostrados = new Set(related.map((r) => r.id));
const masDelTema = allPosts
  .filter((p) => p.id !== post.id && !yaMostrados.has(p.id) && categoriaDe(p.data).id === categoria.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const glosario = (await getCollection('glosario')).map((g) => ({ id: g.id, termino: g.data.termino, description: g.data.description }));
const terminos = terminosEnTexto(post.body ?? '', glosario, 6, 2);
const palabras = (post.body ?? '').split(/\s+/).filter(Boolean).length;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: title,
  description,
  image: `${SITE.url}/og-default.png`,
  inLanguage: SITE.locale,
  keywords: tags.join(', '),
  articleSection: categoria.nombre,
  wordCount: palabras,
  isAccessibleForFree: true,
  ...(resumen ? { abstract: resumen } : {}),
  author: { '@id': `${SITE.url}/autor/#person`, '@type': 'Person', name: author, url: `${SITE.url}/autor/` },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  publisher: { '@id': `${SITE.url}/#organization` },
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntityOfPage: url,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: categoria.nombre, item: `${SITE.url}/blog/tema/${categoria.id}/` },
    { '@type': 'ListItem', position: 4, name: title, item: url },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedDate={pubDate}
  updatedDate={updatedDate}
  extraJsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <div class="barra-lectura" aria-hidden="true"></div>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: categoria.nombre, href: `/blog/tema/${categoria.id}/` }, { label: title }]} />
  <div class="relative">
  <article class="prose max-w-none">
    <h1>{title}</h1>
    <ArticleMeta author={author} pubDate={pubDate} updatedDate={updatedDate} sources={sources} hasAffiliateLinks={hasAffiliateLinks} minutos={minutosDeLectura(post.body ?? '')}>
      {resumen && (
        <p class="not-prose mb-8 rounded-xl border border-brand/20 bg-cream-elevated p-4 text-base leading-relaxed text-ink">
          <strong class="text-brand">En breve:</strong> {resumen}
        </p>
      )}
      <IndiceArticulo headings={headings} lugar="movil" />
      <Content components={{ a: ArticleLink, h2: SeccionH2 }} />
    </ArticleMeta>
  </article>
  <IndiceArticulo headings={headings} lugar="lateral" />
  </div>

  <div class="mx-auto mt-12 max-w-md">
    <NewsletterSignup compacta posicion="final" variante={varianteFinal} tema={temaCta} fraseTema={ctaDeTema(temaCta).boletin} />
  </div>

  <aside aria-labelledby="herramientas-relacionadas" class="mt-12 border-t border-border pt-8">
    <h2 id="herramientas-relacionadas" class="mb-5 font-display text-xl text-ink">Pruébalo con tus números</h2>
    <ul class="grid gap-3">
      {herramientas.map((t) => (
        <li>
          <a href={t.href} class="card group block p-4 hover:border-brand/40">
            <span class="font-display text-lg text-ink group-hover:text-brand">{t.name} <span class="card-flecha" aria-hidden="true">→</span></span>
            <span class="mt-1 block text-sm text-ink-muted">{t.description}</span>
          </a>
        </li>
      ))}
      {tags.includes('fondos indexados') && (
        <li>
          <a href="/carteras/" class="card group block p-4 hover:border-brand/40">
            <span class="font-display text-lg text-ink group-hover:text-brand">Simula tu cartera de fondos indexados <span class="card-flecha" aria-hidden="true">→</span></span>
            <span class="mt-1 block text-sm text-ink-muted">Busca fondos, reparte el peso entre ellos y mira cuánto podrías tener.</span>
          </a>
        </li>
      )}
    </ul>
  </aside>

  {masDelTema.length > 0 && (
    <aside aria-labelledby="mas-del-tema" class="mt-12 border-t border-border pt-8">
      <h2 id="mas-del-tema" class="mb-5 font-display text-xl text-ink">Más sobre <a href={`/blog/tema/${categoria.id}/`} class="enlace-vivo text-brand">{categoria.nombre.toLowerCase()}</a></h2>
      <ListadoTarjetas posts={masDelTema} destacar={false} mostrarTema={false} columnas={2} />
    </aside>
  )}

  {terminos.length > 0 && (
    <aside aria-labelledby="terminos" class="mt-10 border-t border-border pt-8">
      <h2 id="terminos" class="mb-3 font-display text-xl text-ink">Términos de este artículo</h2>
      <ul class="flex flex-wrap gap-2">
        {terminos.map((t) => (
          <li><a href={`/glosario/${t.id}/`} title={t.description} class="chip-tema">{t.termino}</a></li>
        ))}
      </ul>
    </aside>
  )}

  {related.length > 0 && (
    <aside aria-labelledby="sigue-leyendo" class="mt-12 border-t border-border pt-8">
      <h2 id="sigue-leyendo" class="mb-5 font-display text-xl text-ink">Sigue leyendo</h2>
      <ListadoTarjetas posts={related} columnas={2} />
    </aside>
  )}
</BaseLayout>
