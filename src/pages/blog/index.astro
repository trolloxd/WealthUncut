---
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { CATEGORIAS, categoriaDe } from '../../config/categorias';

const posts = (await getCollection('blog', ({ data }) => isPublished(data))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const secciones = CATEGORIAS.map((c) => ({ c, posts: posts.filter((p) => categoriaDe(p.data).id === c.id) })).filter((s) => s.posts.length > 0);
const ultimos = posts.slice(0, 3);
const MAX_POR_TEMA = 4;
const fecha = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Blog de finanzas personales e inversión en España" description={`Artículos de ${SITE.name} sobre fondos indexados, impuestos, vivienda, autónomos y criptomonedas en España, con cifras calculadas y fuentes oficiales, por temas.`}>
  <h1 class="mb-4 font-display text-3xl text-ink">Blog</h1>
  <p class="mb-6 max-w-2xl text-ink-muted">
    Guías de finanzas personales en España, ordenadas por tema, con ejemplos calculados y fuentes oficiales citadas en cada artículo. Si quieres ir directo a los
    números, prueba las <a href="/herramientas/" class="text-brand underline decoration-brand/30 hover:decoration-brand">calculadoras</a> o usa el buscador de arriba.
  </p>

  <nav aria-label="Temas del blog" class="mb-10 flex flex-wrap gap-2">
    {secciones.map(({ c, posts: ps }) => (
      <a href={`#${c.id}`} class="rounded-full border border-border bg-cream-elevated px-4 py-1.5 text-sm font-medium text-ink-muted hover:border-brand/40 hover:text-ink">
        {c.nombre} <span class="text-ink-faint">({ps.length})</span>
      </a>
    ))}
  </nav>

  <section aria-labelledby="ultimos" class="mb-14">
    <h2 id="ultimos" class="mb-5 font-display text-2xl text-ink">Lo último</h2>
    <ul class="grid gap-5 md:grid-cols-3">
      {ultimos.map((post) => (
        <li class="card p-5">
          <a href={`/blog/${post.id}/`} class="group block">
            <span class="text-xs font-semibold uppercase tracking-wide text-brand">{categoriaDe(post.data).nombre}</span>
            <span class="mt-1 block font-display text-lg text-ink group-hover:text-brand">{post.data.title}</span>
            <span class="mt-2 block text-xs text-ink-faint">{fecha(post.data.pubDate)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {secciones.map(({ c, posts: ps }) => (
    <section id={c.id} aria-labelledby={`h-${c.id}`} class="mb-14 scroll-mt-8">
      <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
        <h2 id={`h-${c.id}`} class="font-display text-2xl text-ink">{c.nombre}</h2>
        <a href={`/blog/tema/${c.id}/`} class="text-sm font-medium text-brand underline decoration-brand/30 hover:decoration-brand">
          {ps.length > MAX_POR_TEMA ? `Ver los ${ps.length} artículos` : 'Ver el tema'} →
        </a>
      </div>
      <p class="mb-5 max-w-2xl text-sm text-ink-muted">{c.descripcion}</p>
      <ul class="grid gap-6">
        {ps.slice(0, MAX_POR_TEMA).map((post) => (
          <li class="border-b border-border pb-6 last:border-none">
            <a href={`/blog/${post.id}/`} class="group block">
              <h3 class="font-display text-lg text-ink group-hover:text-brand">{post.data.title}</h3>
              <p class="mt-1 text-sm text-ink-muted">{post.data.description}</p>
              <p class="mt-2 text-xs text-ink-faint">
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fecha(post.data.pubDate)}</time>
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
