---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog" description={`Artículos de ${SITE.name} sobre cuentas, brokers, fondos indexados e impuestos.`}>
  <h1 class="mb-8 font-display text-3xl text-ink">Blog</h1>
  <ul class="grid gap-8">
    {posts.map((post) => (
      <li class="border-b border-border pb-8 last:border-none">
        <a href={`/blog/${post.id}/`} class="group block">
          <h2 class="font-display text-xl text-ink group-hover:text-brand">{post.data.title}</h2>
          <p class="mt-2 text-ink-muted">{post.data.description}</p>
          <p class="mt-3 text-xs text-ink-faint">
            {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
