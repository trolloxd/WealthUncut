---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleLink from '../../../components/ArticleLink.astro';
import { SITE } from '../../../config/site';
import { isPublished } from '../../../lib/posts';
import { contarTermino, normaliza, textoPlano } from '../../../lib/glosario-enlaces';

export async function getStaticPaths() {
  const terminos = (await getCollection('glosario')).sort((a, b) => a.data.termino.localeCompare(b.data.termino, 'es'));
  return terminos.map((t, i) => ({
    params: { id: t.id },
    props: {
      termino: t,
      vecinos: [terminos[i - 1], terminos[i + 1]].filter(Boolean),
    },
  }));
}

const { termino, vecinos } = Astro.props;
const { Content } = await render(termino);
const { titulo, description } = termino.data;
// Los artículos programados o en borrador no se generan: enlazarlos daría 404 hasta su fecha.
const noPublicados = new Set((await getCollection('blog', ({ data }) => !isPublished(data))).map((p) => p.id));
const relacionados = termino.data.relacionados.filter((r) => {
  const slug = r.href.match(/^\/blog\/([^/#?]+)\/?$/)?.[1];
  return !slug || !noPublicados.has(slug);
});
const guias = (await getCollection('blog', ({ data }) => isPublished(data)))
  .map((p) => ({ p, veces: contarTermino(normaliza(textoPlano(p.body ?? '')), termino.data.termino) }))
  .filter((x) => x.veces >= 2 && !relacionados.some((r) => r.href === `/blog/${x.p.id}/`))
  .sort((a, b) => b.veces - a.veces)
  .slice(0, 4)
  .map((x) => x.p);
const url = `${SITE.url}/glosario/${termino.id}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    '@id': `${url}#term`,
    name: termino.data.termino,
    description,
    url,
    inDefinedTermSet: { '@id': `${SITE.url}/glosario/#set` },
    inLanguage: SITE.locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Glosario', item: `${SITE.url}/glosario/` },
      { '@type': 'ListItem', position: 3, name: termino.data.termino, item: url },
    ],
  },
];
---

<BaseLayout title={titulo} description={description} extraJsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Glosario', href: '/glosario/' }, { label: termino.data.termino }]} />
  <article class="prose max-w-none">
    <h1>{titulo}</h1>
    <p class="lead text-lg text-ink">{description}</p>
    <Content components={{ a: ArticleLink }} />
  </article>

  {relacionados.length > 0 && (
    <aside aria-labelledby="para-saber-mas" class="mt-10 border-t border-border pt-8">
      <h2 id="para-saber-mas" class="mb-4 font-display text-xl text-ink">Para saber más</h2>
      <ul class="grid gap-2">
        {relacionados.map((r) => (
          <li><a href={r.href} class="font-medium text-brand underline decoration-brand/30 hover:decoration-brand">{r.label}</a></li>
        ))}
      </ul>
    </aside>
  )}

  {guias.length > 0 && (
    <aside aria-labelledby="guias-que-lo-mencionan" class="mt-8">
      <h2 id="guias-que-lo-mencionan" class="mb-3 font-display text-xl text-ink">Guías donde se explica</h2>
      <ul class="grid gap-2">
        {guias.map((p) => (
          <li><a href={`/blog/${p.id}/`} class="font-medium text-brand underline decoration-brand/30 hover:decoration-brand">{p.data.title}</a></li>
        ))}
      </ul>
    </aside>
  )}

  <nav aria-label="Otros términos" class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-6 text-sm">
    <a href="/glosario/" class="font-medium text-ink-muted underline hover:text-ink">Todo el glosario</a>
    <span class="flex flex-wrap gap-4">
      {vecinos.map((v) => (
        <a href={`/glosario/${v.id}/`} class="text-brand underline decoration-brand/30 hover:decoration-brand">{v.data.termino}</a>
      ))}
    </span>
  </nav>

  <p class="mt-8 rounded-xl border border-border bg-cream-elevated p-4 text-sm text-ink-muted">
    <strong class="text-ink">Aviso:</strong> definiciones divulgativas, no asesoramiento financiero ni
    fiscal personalizado. Así trabajamos: <a href="/metodologia/" class="underline decoration-ink-muted/40 hover:text-ink">metodología</a>.
  </p>
</BaseLayout>
