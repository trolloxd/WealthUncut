---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Buscar en WealthUncut';
const description = 'Busca entre las guías, herramientas y términos del glosario de WealthUncut.';

---

<BaseLayout title={title} description={description} noindex>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Buscar' }]} />
  <h1 class="mb-4 font-display text-3xl text-ink">Buscar</h1>
  <p class="mb-6 max-w-2xl text-ink-muted">
    Escribe lo que buscas (por ejemplo "TER", "hipoteca" o "fondo de emergencia") y te enseñamos las
    guías, herramientas y términos del glosario que coinciden.
  </p>

  <div id="buscador">
    <label class="grid gap-1 text-sm font-medium text-ink-muted">
      Buscar
      <input id="q" type="search" autocomplete="off" class="campo-input" placeholder="Ej. hipoteca, TER, modelo 720..." />
    </label>
    <p id="estado" class="mt-3 text-sm text-ink-faint" aria-live="polite"></p>
    <ul id="resultados" class="mt-4 grid gap-3"></ul>
  </div>
  <noscript>
    <p class="mt-4 text-sm text-ink-muted">
      El buscador necesita JavaScript. Mientras tanto, mira <a href="/empieza-aqui/" class="underline">Empieza aquí</a>
      o el <a href="/glosario/" class="underline">glosario</a>.
    </p>
  </noscript>
</BaseLayout>

<script>
  import { buscar, cargarIndice } from '../lib/buscador-cliente';

  const entrada = document.getElementById('q') as HTMLInputElement | null;
  const lista = document.getElementById('resultados');
  const estado = document.getElementById('estado');

  if (entrada && lista && estado) {
    const pintar = async () => {
      const q = entrada.value.trim();
      lista.textContent = '';
      if (!q) {
        estado.textContent = '';
        return;
      }
      const resultados = buscar(await cargarIndice(), q, 30);
      estado.textContent = resultados.length === 0 ? 'No hay resultados. Prueba con otra palabra.' : `${resultados.length} resultado${resultados.length === 1 ? '' : 's'}`;
      for (const e of resultados) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = e.u;
        a.className = 'block rounded-xl border border-border bg-cream-elevated p-4 hover:border-brand/40';
        const etiqueta = document.createElement('span');
        etiqueta.className = 'text-xs font-semibold uppercase tracking-wide text-brand';
        etiqueta.textContent = e.k;
        const t = document.createElement('span');
        t.className = 'mt-0.5 block font-medium text-ink';
        t.textContent = e.t;
        a.append(etiqueta, t);
        li.appendChild(a);
        lista.appendChild(li);
      }
    };

    entrada.addEventListener('input', () => void pintar());
    const q = new URLSearchParams(window.location.search).get('q');
    if (q) {
      entrada.value = q.slice(0, 80);
      void pintar();
    }
  }
</script>
