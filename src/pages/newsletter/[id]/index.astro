---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleMeta from '../../../components/ArticleMeta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleLink from '../../../components/ArticleLink.astro';
import NewsletterSignup from '../../../components/NewsletterSignup.astro';
import { isPublished } from '../../../lib/posts';
import { SITE, AUTHOR } from '../../../config/site';

export async function getStaticPaths() {
  const numeros = (await getCollection('newsletter', ({ data }) => isPublished(data))).sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
  );
  return numeros.map((numero, i) => ({
    params: { id: numero.id },
    props: { numero, anterior: numeros[i - 1], siguiente: numeros[i + 1] },
  }));
}

const { numero, anterior, siguiente } = Astro.props;
const { Content } = await render(numero);
const { title, description, pubDate } = numero.data;
const url = `${SITE.url}/newsletter/${numero.id}/`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: title,
  description,
  image: `${SITE.url}/og-default.png`,
  inLanguage: SITE.locale,
  author: { '@id': `${SITE.url}/autor/#person`, '@type': 'Person', name: AUTHOR.name, url: `${SITE.url}/autor/` },
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  publisher: { '@id': `${SITE.url}/#organization` },
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntityOfPage: url,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Newsletter', item: `${SITE.url}/newsletter/` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<BaseLayout title={title} description={description} type="article" publishedDate={pubDate} extraJsonLd={[articleJsonLd, breadcrumbJsonLd]}>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Newsletter', href: '/newsletter/' }, { label: title }]} />
  <article class="prose max-w-none">
    <h1>{title}</h1>
    <ArticleMeta author={AUTHOR.name} pubDate={pubDate} sources={[]} hasAffiliateLinks={false}>
      <Content components={{ a: ArticleLink }} />
    </ArticleMeta>
  </article>

  <div class="not-prose mt-10 max-w-md">
    <NewsletterSignup compacta />
  </div>

  <nav aria-label="Otros números" class="mt-10 flex flex-wrap justify-between gap-4 border-t border-border pt-6 text-sm">
    {anterior ? (
      <a href={`/newsletter/${anterior.id}/`} class="text-brand underline decoration-brand/30 hover:decoration-brand">← {anterior.data.title}</a>
    ) : <span />}
    {siguiente && (
      <a href={`/newsletter/${siguiente.id}/`} class="text-right text-brand underline decoration-brand/30 hover:decoration-brand">{siguiente.data.title} →</a>
    )}
  </nav>
</BaseLayout>
