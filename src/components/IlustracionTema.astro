---
/**
 * Imagen por tema de las tarjetas de artículo (las ocho categorías de src/config/categorias.ts): el icono del tema
 * (GlifoTema) en grande sobre su color, con una sombra del mismo icono desplazada que le da volumen. Lo importante queda
 * en el centro, porque en las miniaturas estrechas se recortan los lados (slice).
 * Es decorativa (aria-hidden): el nombre del tema siempre va en texto junto a ella. Estática, sin estilos en línea (CSP).
 * Con la tarjeta enfocada o con el ratón encima, las piezas con `arte-flota` se mueven (src/styles/tarjetas.css).
 */
import GlifoTema from './GlifoTema.astro';
import { fondoTema } from '../config/iconos-tema';

interface Props {
  tema: string;
}
const { tema } = Astro.props;
const oscuro = tema === 'criptomonedas';
---

<svg class="ilustracion-tema" viewBox="0 0 240 120" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <rect width="240" height="120" fill={fondoTema(tema)} />
  <g fill={oscuro ? '#faf6ed' : '#1e4a3a'} fill-opacity="0.06">
    <circle cx="40" cy="96" r="64" />
    <circle cx="214" cy="18" r="46" />
  </g>
  <g transform="translate(82 22) scale(1.18)" opacity="0.18">
    <g transform="translate(5 5)"><GlifoTema tema={tema} /></g>
  </g>
  <g transform="translate(82 22) scale(1.18)"><GlifoTema tema={tema} /></g>
</svg>
