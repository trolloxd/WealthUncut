---
/** Tabla de tramos del IRPF del ahorro, generada desde finance.ts (única fuente de cifras). */
import { IRPF_AHORRO_BRACKETS, IRPF_AHORRO_FUENTE } from '../config/finance';

const euros = (n: number) => `${new Intl.NumberFormat('es-ES', { useGrouping: 'always' }).format(n)} €`;
const pct = (n: number) => `${Math.round(n * 100)}%`;

const filas = IRPF_AHORRO_BRACKETS.map((tramo, i) => {
  const desde = i === 0 ? 0 : IRPF_AHORRO_BRACKETS[i - 1].hasta;
  const texto =
    i === 0
      ? `Hasta ${euros(tramo.hasta)}`
      : tramo.hasta === Infinity
        ? `Más de ${euros(desde)}`
        : `De ${euros(desde)} a ${euros(tramo.hasta)}`;
  return { texto, tipo: pct(tramo.tipo) };
});
---

<table>
  <thead>
    <tr>
      <th scope="col">Parte de la ganancia</th>
      <th scope="col">Tipo que se aplica a esa parte</th>
    </tr>
  </thead>
  <tbody>
    {filas.map((f) => (
      <tr>
        <td>{f.texto}</td>
        <td>{f.tipo}</td>
      </tr>
    ))}
  </tbody>
</table>
<p class="text-sm text-ink-muted">
  Tipos generales (escala estatal más autonómica) según el{' '}
  <a href={IRPF_AHORRO_FUENTE.url} rel="noopener" target="_blank">Manual práctico de Renta 2025</a> de
  la Agencia Tributaria.
  {!IRPF_AHORRO_FUENTE.verificado && <strong class="text-accent">Pendientes de verificación final para el ejercicio en curso.</strong>}
</p>
