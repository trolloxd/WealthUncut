---
import { SITE } from '../config/site';

const navItems = [
  { href: '/mercados/', label: 'Mercados' },
  { href: '/blog/', label: 'Blog' },
  { href: '/herramientas/', label: 'Herramientas' },
  { href: '/newsletter/', label: 'Newsletter' },
  { href: '/autor/', label: 'Autor' },
  { href: '/metodologia/', label: 'Metodología' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="border-b border-border">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-5 sm:px-6">
    <a href="/" class="font-display text-xl font-semibold tracking-tight text-brand">
      {SITE.name}
    </a>
    <nav aria-label="Principal" class="order-3 flex w-full flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium text-ink-muted sm:order-none sm:w-auto sm:gap-x-7">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : undefined}
          class:list={['hover:text-ink', isCurrent(item.href) && 'text-ink']}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a href="/blog/rentabilidad-neta-fondo-indexado/" class="btn-primary text-xs sm:text-sm">
      Probar la calculadora
    </a>
  </div>
</header>
