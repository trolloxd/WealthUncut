---
/**
 * Evolución de las TAE del comparador de cuentas y depósitos a partir de
 * src/data/cuentas-remuneradas/historico.json (una instantánea por actualización). Gráfica SVG
 * generada al construir la web, sin JavaScript en el navegador. Con menos de 2 instantáneas no
 * se muestra nada.
 */
interface Snapshot {
  fecha: string;
  cuentas: { tae: number; vinculacion: boolean }[];
  depositos: { tae: number; plazoMeses: number }[];
}
interface Props {
  snapshots: Snapshot[];
}

const { snapshots } = Astro.props;
const media = (xs: number[]) => (xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : null);

const puntosCuentaMejor = snapshots.map((s) => [s.fecha, Math.max(...s.cuentas.filter((c) => !c.vinculacion).map((c) => c.tae))] as [string, number]);
const puntosCuentaMedia = snapshots.map((s) => [s.fecha, media(s.cuentas.filter((c) => !c.vinculacion).map((c) => c.tae))!] as [string, number]);
const puntosDepositoMedia = snapshots.map((s) => [s.fecha, media(s.depositos.filter((d) => d.plazoMeses === 12).map((d) => d.tae))!] as [string, number]);

const series = [
  { nombre: 'Mejor cuenta sin vinculación', puntos: puntosCuentaMejor, color: 'var(--color-brand)' },
  { nombre: 'Media de cuentas sin vinculación', puntos: puntosCuentaMedia, color: 'var(--color-accent)' },
  { nombre: 'Media de depósitos a 12 meses', puntos: puntosDepositoMedia, color: 'var(--color-ink-muted)' },
];

const todos = series.flatMap((s) => s.puntos.map(([, v]) => v));
const min = Math.min(...todos);
const max = Math.max(...todos);
const margen = (max - min || 1) * 0.12;
const yMin = Math.max(0, min - margen);
const yMax = max + margen;

const W = 640;
const H = 240;
const PAD = { top: 16, right: 52, bottom: 28, left: 12 };
const n = snapshots.length;
const x = (i: number) => PAD.left + (i / Math.max(1, n - 1)) * (W - PAD.left - PAD.right);
const y = (v: number) => PAD.top + (1 - (v - yMin) / (yMax - yMin)) * (H - PAD.top - PAD.bottom);
const fmt = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fecha = (f: string) => new Date(`${f}T12:00:00Z`).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: '2-digit' });
const primera = snapshots[0].fecha;
const ultima = snapshots[n - 1].fecha;
const descripcion = series
  .map((s) => `${s.nombre}: de ${fmt(s.puntos[0][1])}% a ${fmt(s.puntos[n - 1][1])}%`)
  .join('. ');
---

{n >= 2 && (
  <figure class="not-prose my-8">
    <figcaption class="mb-2 text-sm font-semibold text-ink">
      Cómo han evolucionado las TAE <span class="font-normal text-ink-muted">(% TAE, de {fecha(primera)} a {fecha(ultima)})</span>
    </figcaption>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={descripcion} class="h-auto w-full rounded-xl border border-border bg-cream-elevated">
      {[max, (max + min) / 2, min].map((v) => (
        <g>
          <line x1={PAD.left} x2={W - PAD.right} y1={y(v)} y2={y(v)} stroke="var(--color-border)" stroke-width="1" />
          <text x={W - PAD.right + 6} y={y(v) + 4} font-size="11" fill="var(--color-ink-muted)">{fmt(v)}</text>
        </g>
      ))}
      {series.map((s) => (
        <g>
          <polyline
            points={s.puntos.map(([, v], i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ')}
            fill="none"
            stroke={s.color}
            stroke-width="2"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
          <circle cx={x(n - 1)} cy={y(s.puntos[n - 1][1])} r="3.5" fill={s.color} />
        </g>
      ))}
      <text x={PAD.left} y={H - 8} font-size="11" fill="var(--color-ink-muted)">{fecha(primera)}</text>
      <text x={W - PAD.right} y={H - 8} font-size="11" fill="var(--color-ink-muted)" text-anchor="end">{fecha(ultima)}</text>
    </svg>
    <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-muted">
      {series.map((s) => (
        <li class="flex items-center gap-1.5">
          <svg width="14" height="4" aria-hidden="true"><rect width="14" height="4" rx="2" fill={s.color} /></svg>
          {s.nombre}: {fmt(s.puntos[n - 1][1])}%
        </li>
      ))}
    </ul>
    <p class="mt-1 text-xs text-ink-faint">
      Una instantánea por cada actualización semanal del comparador. Las medias se calculan sobre las
      entidades que figuraban en cada fecha, que pueden cambiar de una semana a otra.
    </p>
  </figure>
)}
