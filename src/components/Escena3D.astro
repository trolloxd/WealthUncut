---
/**
 * <Escena3D escena="irpf-ahorro" /> o <Escena3D escena="interes-compuesto" />: gráfico 3D reutilizable para artículos MDX.
 *
 * Cómo funciona (más en el CLAUDE.md del repo):
 * - El servidor calcula los datos (src/lib/calculos/escena3d.ts, con las cifras de finance.ts) y pinta una versión 2D con
 *   barras y una tabla. Eso es lo que ven sin JavaScript, sin WebGL o con "reducir movimiento" activado.
 * - Cuando la figura entra en pantalla, el navegador tiene WebGL y no se ha pedido menos movimiento, se descarga three.js
 *   (src/scripts/escena3d.ts, carga perezosa) y el 3D sustituye al 2D dentro de la misma caja: tamaño fijo, CLS 0.
 * - Teclado: el gráfico recibe foco; flechas giran, + y - acercan, Inicio reinicia. Sin estilos en línea ni terceros.
 *
 * En un MDX: import Escena3D from '../../components/Escena3D.astro';  y  <Escena3D escena="irpf-ahorro" />
 */
import { claseAnchoBarra } from './CalculatorUI';
import { SUPUESTOS_INTERES, datosEscena, textoEuros, textoPct, type TipoEscena } from '../lib/calculos/escena3d';
import euribor from '../data/euribor/ultimo.json';

interface Props {
  escena: TipoEscena;
}

const { escena } = Astro.props;
const mesLargo = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${euribor.ultimoMes}-15T12:00:00Z`));
const datos = datosEscena(escena, { euribor: euribor.ultimoValor, euriborMes: mesLargo, euriborUrl: '/euribor/' });
const num = (n: number) => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.');

const maxTipo = Math.max(...(datos.escalones ?? []).map((e) => e.tipo), 0.01);
const escalones = (datos.escalones ?? []).map((e) => ({
  nombre: e.hasta === null ? `Más de ${num(e.desde)} €` : e.desde === 0 ? `Hasta ${num(e.hasta)} €` : `De ${num(e.desde)} a ${num(e.hasta)} €`,
  tipo: textoPct(e.tipo),
  ancho: claseAnchoBarra((e.tipo / maxTipo) * 100, 5),
}));

// Barras agrupadas (coste del TER y cuota según el euríbor): la barra más alta ocupa todo el ancho.
const COLOR_TONO = ['bg-brand/55', 'bg-brand', 'bg-ink-muted', 'bg-accent'] as const;
const grupos = datos.grupos ?? [];
const maximoGrupos = Math.max(...grupos.flatMap((g) => g.barras.map((b) => b.valor)), 1);
const gruposPlano = grupos.map((g) => ({
  ...g,
  barras: g.barras.map((b) => ({ ...b, ancho: claseAnchoBarra((b.valor / maximoGrupos) * 100, 5), color: COLOR_TONO[b.tono] })),
}));

const serie = datos.serie ?? [];
const maximo = Math.max(...serie.map((p) => p.total), 1);
const filas = serie.map((p) => ({
  ...p,
  anchoAportado: claseAnchoBarra((p.aportado / maximo) * 100, 0),
  anchoIntereses: claseAnchoBarra((p.intereses / maximo) * 100, 0),
}));
---

<figure class="escena3d not-prose my-8" data-escena3d={escena} data-datos={JSON.stringify(datos)}>
  <figcaption class="mb-3 font-display text-lg text-ink">{datos.titulo}</figcaption>
  <div
    class="relative h-[24rem] w-full overflow-hidden rounded-2xl border border-border bg-brand-soft sm:h-[26rem]"
    data-lienzo
  >
    <div class="absolute inset-0 overflow-y-auto p-4 sm:p-5" data-plano>
      {
        escena === 'irpf-ahorro' && (
          <ul class="grid min-h-full content-center gap-3">
            {escalones.map((e) => (
              <li class="grid gap-1">
                <p class="flex justify-between gap-3 text-sm text-ink">
                  <span>{e.nombre}</span>
                  <span class="font-semibold text-brand">{e.tipo}</span>
                </p>
                <div class="h-4 rounded bg-cream-elevated">
                  <div data-barra class:list={['h-4 rounded bg-brand', e.ancho]} />
                </div>
              </li>
            ))}
          </ul>
        )
      }
      {
        grupos.length > 0 && (
          <div class="grid min-h-full content-center gap-3">
            {gruposPlano.map((g) => (
              <div class="grid gap-1">
                {gruposPlano.length > 1 && <p class="text-sm font-semibold text-ink">{g.etiqueta}</p>}
                {g.barras.map((b) => (
                  <div class="grid gap-0.5">
                    <p class="flex justify-between gap-3 text-xs text-ink">
                      <span>{b.etiqueta}</span>
                      <span class="font-semibold">{b.texto}</span>
                    </p>
                    <div class="h-3 rounded bg-cream-elevated">
                      <div data-barra class:list={['h-3 rounded', b.color, b.ancho]} />
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </div>
        )
      }
      {
        escena === 'interes-compuesto' && (
          <ul class="grid min-h-full content-center gap-2">
            {filas.map((f) => (
              <li class="grid gap-0.5">
                <p class="flex justify-between gap-3 text-xs text-ink sm:text-sm">
                  <span class="font-semibold">{f.anio} años</span>
                  <span>
                    {num(f.aportado)} € aportados + {num(f.intereses)} € de intereses
                  </span>
                </p>
                <div class="flex h-3 overflow-hidden rounded bg-cream-elevated">
                  <div data-barra class:list={['h-3 shrink-0 bg-ink-muted', f.anchoAportado]} />
                  <div data-barra class:list={['h-3 shrink-0 bg-brand', f.anchoIntereses]} />
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
  {
    grupos.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink" aria-label="Leyenda de colores">
        {(datos.leyenda ?? []).map((l) => (
          <li class="flex items-center gap-1.5">
            <span class:list={['inline-block h-3 w-3 rounded-sm', COLOR_TONO[l.tono]]} aria-hidden="true" />
            {l.texto}
          </li>
        ))}
      </ul>
    )
  }
  <p class="mt-2 text-xs text-ink-faint">
    Si tu navegador lo permite, el gráfico se muestra en 3D: gíralo con el ratón, el dedo o las flechas del teclado (+ y - acercan, Inicio reinicia).
    Los mismos datos están en la tabla de abajo.
  </p>
  {datos.nota && <p class="mt-2 text-xs text-ink-faint">{datos.nota}</p>}
  {
    escena === 'interes-compuesto' && (
      <p class="mt-2 text-xs text-ink-faint">
        Ejemplo ilustrativo, no una previsión: {num(SUPUESTOS_INTERES.aporteMensual)} € al mes, {textoPct(SUPUESTOS_INTERES.rentabilidadBruta)} bruto anual y TER del {textoPct(SUPUESTOS_INTERES.ter)}; valores brutos, antes de impuestos.
      </p>
    )
  }
  <details class="mt-3 text-sm text-ink">
    <summary class="cursor-pointer font-semibold text-brand">Ver los datos en una tabla</summary>
    <p class="mt-2 text-ink-muted">{datos.resumen}</p>
    {
      escena === 'irpf-ahorro' && (
        <table class="mt-2 w-full text-left text-sm">
          <caption class="sr-only">Tramos del IRPF del ahorro y tipo de cada uno</caption>
          <thead>
            <tr>
              <th scope="col" class="py-1 pr-3">Parte de la renta del ahorro</th>
              <th scope="col" class="py-1">Tipo</th>
            </tr>
          </thead>
          <tbody>
            {escalones.map((e) => (
              <tr class="border-t border-border">
                <td class="py-1 pr-3">{e.nombre}</td>
                <td class="py-1">{e.tipo}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
    {
      grupos.length > 0 && (
        <table class="mt-2 w-full text-left text-sm">
          <caption class="sr-only">{datos.titulo}</caption>
          <thead>
            <tr>
              <th scope="col" class="py-1 pr-3">{gruposPlano.length > 1 ? 'Años' : 'Escenario'}</th>
              {gruposPlano.length > 1 ? (
                (datos.leyenda ?? []).map((l) => <th scope="col" class="py-1 pr-3">{l.texto}</th>)
              ) : (
                <th scope="col" class="py-1">{gruposPlano[0].etiqueta}</th>
              )}
            </tr>
          </thead>
          <tbody>
            {gruposPlano.length > 1
              ? gruposPlano.map((g) => (
                  <tr class="border-t border-border">
                    <td class="py-1 pr-3">{g.etiqueta}</td>
                    {g.barras.map((b) => <td class="py-1 pr-3">{b.texto}</td>)}
                  </tr>
                ))
              : gruposPlano[0].barras.map((b) => (
                  <tr class="border-t border-border">
                    <td class="py-1 pr-3">{b.etiqueta}</td>
                    <td class="py-1">{b.texto}</td>
                  </tr>
                ))}
          </tbody>
        </table>
      )
    }
    {
      escena === 'interes-compuesto' && (
        <table class="mt-2 w-full text-left text-sm">
          <caption class="sr-only">Lo aportado, los intereses y el total cada cinco años</caption>
          <thead>
            <tr>
              <th scope="col" class="py-1 pr-3">Años</th>
              <th scope="col" class="py-1 pr-3">Aportado</th>
              <th scope="col" class="py-1 pr-3">Intereses</th>
              <th scope="col" class="py-1">Total</th>
            </tr>
          </thead>
          <tbody>
            {serie.map((p) => (
              <tr class="border-t border-border">
                <td class="py-1 pr-3">{p.anio}</td>
                <td class="py-1 pr-3">{textoEuros(p.aportado).replace(' euros', ' €')}</td>
                <td class="py-1 pr-3">{textoEuros(p.intereses).replace(' euros', ' €')}</td>
                <td class="py-1">{textoEuros(p.total).replace(' euros', ' €')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </details>
  <p class="mt-2 text-xs text-ink-faint">
    Fuente:{' '}
    <a href={datos.fuente.url} class="underline" rel="noopener" target={datos.fuente.url.startsWith('http') ? '_blank' : undefined}>{datos.fuente.etiqueta}</a>.
  </p>
</figure>

<script>
  // Carga perezosa: three.js solo se descarga cuando una figura entra en pantalla, hay WebGL y no se ha pedido menos movimiento.
  const figuras = document.querySelectorAll<HTMLElement>('[data-escena3d]');
  const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hayWebGL = () => {
    try {
      const c = document.createElement('canvas');
      return Boolean(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  };
  if (figuras.length > 0 && !menosMovimiento && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          observador.unobserve(entrada.target);
          if (!hayWebGL()) continue;
          import('../scripts/escena3d')
            .then((m) => m.montar(entrada.target as HTMLElement))
            .catch(() => {
              /* se queda la versión 2D */
            });
        }
      },
      { rootMargin: '200px' }
    );
    figuras.forEach((f) => observador.observe(f));
  }
</script>
