---
interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="Migas de pan" class="not-prose mb-6 text-sm text-ink-faint">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((item, i) => (
      <li class="flex min-w-0 items-center gap-1">
        {item.href ? (
          <a href={item.href} class="-my-3 inline-block py-3 hover:text-ink">{item.label}</a>
        ) : (
          <span aria-current="page" class="block truncate text-ink-muted" title={item.label}>{item.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
