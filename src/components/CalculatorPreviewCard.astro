---
// Vista previa estática (no interactiva) del simulador, con los mismos
// valores de ejemplo que el artículo real, para que la home cargue rápido
// sin necesitar la isla de React.
---

<div class="browser-card">
  <div class="browser-card-chrome">
    <span class="browser-card-dot"></span>
    <span class="browser-card-dot"></span>
    <span class="browser-card-dot"></span>
    <span class="ml-2 truncate text-xs text-ink-faint">wealthuncut.com/blog/rentabilidad-neta-fondo-indexado</span>
  </div>

  <div class="p-6">
    <p class="text-xs font-semibold uppercase tracking-wide text-ink-faint">
      Simulador · Fondo indexado, 20 años
    </p>
    <p class="mt-2 font-display text-xl leading-snug text-ink sm:text-2xl">
      Con 150 €/mes te quedarían <span class="text-brand">69.630 € netos</span>,
      después de comisiones e impuestos.
    </p>

    <div class="mt-6 grid grid-cols-2 gap-4">
      <div class="rounded-xl border border-border bg-cream p-4">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-ink-faint">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-brand-soft text-[11px] text-brand">1</span>
          Aportado
        </p>
        <p class="mt-2 text-lg font-semibold text-ink">37.000 €</p>
      </div>
      <div class="rounded-xl border border-border bg-cream p-4">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-ink-faint">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-accent-soft text-[11px] text-accent">2</span>
          Impuesto (IRPF ahorro)
        </p>
        <p class="mt-2 text-lg font-semibold text-accent">− 8.522 €</p>
      </div>
    </div>

    <div class="mt-4">
      <div class="h-2 w-full overflow-hidden rounded-full bg-cream">
        <div class="h-full w-[89%] rounded-full bg-brand"></div>
      </div>
      <p class="mt-2 text-xs text-ink-faint">89% del valor final se lo queda quien invierte, 11% va a impuestos.</p>
    </div>
  </div>
</div>
